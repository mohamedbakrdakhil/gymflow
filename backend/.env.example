# --- Environnement ---
NODE_ENV=development
PORT=5000

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gymflow
DB_DIALECT=mysql

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string_in_production_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SMTP (emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gymflow.ma
EMAIL_FROM_NAME=GymFlow

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# --- Stripe (paiements en ligne - Plan PRO) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CMI (paiement marocain - placeholder) ---
CMI_MERCHANT_ID=
CMI_STORE_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# --- Logs ---
LOG_LEVEL=info
