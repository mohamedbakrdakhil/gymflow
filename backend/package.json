{
  "name": "gymflow-backend",
  "version": "1.0.0",
  "description": "GymFlow - SaaS multi-tenant pour salles de sport au Maroc (backend)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:sync": "node src/utils/db-sync.js",
    "db:seed": "node src/seeders/index.js",
    "db:reset": "node src/utils/db-sync.js --force && node src/seeders/index.js",
    "lint": "eslint src --ext .js"
  },
  "keywords": ["saas", "gym", "fitness", "morocco", "multi-tenant"],
  "author": "GymFlow",
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "eslint": "^9.8.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
